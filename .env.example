APP_PORT=8080
GIN_MODE=release

DATABASE_DSN=postgres://postgres:postgres@db:5432/authz?sslmode=disable

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=supersecretchangeme
JWT_ISSUER=authzsvc
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=168h

OTP_TTL=5m
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_WINDOW=60s

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

CASBIN_MODEL=/app/casbin/model.conf

# Bootstrap accounts created idempotently at startup (optional).
# Root administrator: created only if all three are set and no user with role "root" exists.
# Env vars override the optional config/config.yml section bootstrap.root_admin.{email,phone,password}.
ROOT_ADMIN_EMAIL=
ROOT_ADMIN_PHONE=
ROOT_ADMIN_PASSWORD=
# Dedicated "admin" account for another backend service (optional; keyed on its email).
# yaml: bootstrap.service_admin.{email,phone,password}
SERVICE_ADMIN_EMAIL=
SERVICE_ADMIN_PHONE=
SERVICE_ADMIN_PASSWORD=

# Backend identity translation (optional). Rules using token.backend_user_id and the
# x-backend-user-id response header of /external/authz/check resolve the caller's backend user id
# through GET {url}/api/v1/internal/users/authz/{authz_user_id}/backend (header X-API-Key).
# Empty URL = not configured (rules needing the backend id fail closed with 500; header left empty).
# Results are cached in Redis (found: 5m, not found: 30s). Keep the API key secret; it is never logged.
# yaml: identity_backend.{url,api_key,timeout}
IDENTITY_BACKEND_URL=
IDENTITY_BACKEND_API_KEY=
IDENTITY_BACKEND_TIMEOUT=2s

# Registration switches for phone-first clients (both default to true = strict behaviour).
# yaml: registration.{require_email,require_phone_verification}; the environment overrides the file.
# REQUIRE_REGISTRATION_EMAIL=false  -> e-mail is optional at POST /auth/register and POST /admin/users
#   (an e-mail that is sent is still validated; a missing one is stored as NULL, so the phone is the
#   only identifier and must be unique).
# REQUIRE_PHONE_VERIFICATION=false  -> unverified users can log in and registration sends no OTP
#   (the /auth/otp/* endpoints keep working). Access tokens always carry phone_verified, so gateway
#   rules can require it per route with token.phone_verified.
REQUIRE_REGISTRATION_EMAIL=true
REQUIRE_PHONE_VERIFICATION=true
